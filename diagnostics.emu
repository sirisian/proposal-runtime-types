<!-- Generated from diagnostics.json. -->
<emu-clause id="sec-diagnostic-registry">
  <h1>Diagnostic Rule Index</h1>
  <p>This informative index identifies rule families and links to their normative clauses. It does not define an additional rejection predicate. Provisional identifiers may be refined; stable and retired identifiers are never repurposed.</p>
  <emu-table><emu-caption>Diagnostic rule identities</emu-caption><table>
    <thead><tr><th>Rule</th><th>Diagnostic family</th><th>Applicability</th><th>Meaning and normative source</th></tr></thead>
    <tbody>
      <tr><td><dfn id="rt-default-evaluation">rt-default-evaluation</dfn></td><td><code>RT_DEFAULT_EVALUATION</code> (provisional)</td><td>Everywhere</td><td>A required default cannot be evaluated. Supply an evaluable default or an explicit initializer. <emu-xref href="#sec-default-values"></emu-xref></td></tr>
      <tr><td><dfn id="rt-default-conversion">rt-default-conversion</dfn></td><td><code>RT_DEFAULT_CONVERSION</code> (provisional)</td><td>Everywhere</td><td>The default cannot undergo the declared conversion. <emu-xref href="#sec-default-values"></emu-xref></td></tr>
      <tr><td><dfn id="rt-where-unsatisfied">rt-where-unsatisfied</dfn></td><td><code>RT_WHERE_UNSATISFIED</code> (provisional)</td><td>Everywhere</td><td>The application fails a declared constraint. <emu-xref href="#sec-generic-where"></emu-xref></td></tr>
      <tr><td><dfn id="rt-unclaimed-metadata">rt-unclaimed-metadata</dfn></td><td><code>RT_UNCLAIMED_METADATA</code> (provisional)</td><td>Everywhere</td><td>A metadata key has no governing meta declaration. <emu-xref href="#sec-primitive-metadata"></emu-xref></td></tr>
      <tr><td><dfn id="rt-enum-initializer">rt-enum-initializer</dfn></td><td><code>RT_ENUM_INITIALIZER</code> (provisional)</td><td>Everywhere</td><td>An enum initializer violates its binding, evaluability, or value contract. <emu-xref href="#sec-enums"></emu-xref></td></tr>
      <tr><td><dfn id="rt-specialization">rt-specialization</dfn></td><td><code>RT_SPECIALIZATION</code> (provisional)</td><td>Everywhere</td><td>The call cannot be specialized under the declared constraints. <emu-xref href="#sec-generic-specialization"></emu-xref></td></tr>
      <tr><td><dfn id="rt-type-evaluation">rt-type-evaluation</dfn></td><td><code>RT_TYPE_EVALUATION</code> (provisional)</td><td>Everywhere</td><td>A required type computation cannot complete normally, or a closed type expression does not produce a Type Object. <emu-xref href="#sec-compile-time-evaluability"></emu-xref>, <emu-xref href="#sec-module-type-checking-order"></emu-xref>, <emu-xref href="#sec-specialization-predicate-completion"></emu-xref></td></tr>
      <tr><td><dfn id="rt-impossible-test">rt-impossible-test</dfn></td><td><code>RT_IMPOSSIBLE_TEST</code> (provisional)</td><td>Checked code</td><td>The deciding test necessarily succeeds or necessarily fails under the specified stable facts. <emu-xref href="#sec-narrowfrom"></emu-xref></td></tr>
      <tr><td><dfn id="rt-empty-intersection">rt-empty-intersection</dfn></td><td><code>RT_EMPTY_INTERSECTION</code> (provisional)</td><td>Everywhere</td><td>The declared intersection has no inhabitant under the specified stable judgment. <emu-xref href="#sec-intersection-type-early-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-assignability">rt-assignability</dfn></td><td><code>RT_ASSIGNABILITY</code> (provisional)</td><td>Everywhere</td><td>The established source cannot satisfy the declared destination contract. <emu-xref href="#sec-isassignable"></emu-xref></td></tr>
      <tr><td><dfn id="rt-uninhabited-declaration">rt-uninhabited-declaration</dfn></td><td><code>RT_UNINHABITED_DECLARATION</code> (provisional)</td><td>Everywhere</td><td>The declared type cannot have an initialized value. <emu-xref href="#sec-never-type"></emu-xref></td></tr>
      <tr><td><dfn id="rt-missing-default">rt-missing-default</dfn></td><td><code>RT_MISSING_DEFAULT</code> (provisional)</td><td>Everywhere</td><td>The declaration needs an initializer because its type has no default. <emu-xref href="#sec-default-values"></emu-xref></td></tr>
      <tr><td><dfn id="rt-inherited-contract">rt-inherited-contract</dfn></td><td><code>RT_INHERITED_CONTRACT</code> (provisional)</td><td>Everywhere</td><td>An implementation or override fails the inherited callable or member contract. <emu-xref href="#sec-typed-classes"></emu-xref></td></tr>
      <tr><td><dfn id="rt-generic-binding-order">rt-generic-binding-order</dfn></td><td><code>RT_GENERIC_BINDING_ORDER</code> (provisional)</td><td>Everywhere</td><td>A parameter constraint or default reads a binding before it is available. <emu-xref href="#sec-type-parameters"></emu-xref></td></tr>
      <tr><td><dfn id="rt-variadic-contract">rt-variadic-contract</dfn></td><td><code>RT_VARIADIC_CONTRACT</code> (provisional)</td><td>Everywhere</td><td>The variadic declaration or rest boundary does not meet its required type or separation rule. <emu-xref href="#sec-variadic-parameters"></emu-xref></td></tr>
      <tr><td><dfn id="rt-generic-constraint">rt-generic-constraint</dfn></td><td><code>RT_GENERIC_CONSTRAINT</code> (provisional)</td><td>Everywhere</td><td>The argument does not satisfy the type parameter constraint. <emu-xref href="#sec-type-parameters"></emu-xref></td></tr>
      <tr><td><dfn id="rt-return-contract">rt-return-contract</dfn></td><td><code>RT_RETURN_CONTRACT</code> (provisional)</td><td>Everywhere</td><td>An established return value cannot satisfy the function return contract. <emu-xref href="#sec-typed-arrow-functions"></emu-xref></td></tr>
      <tr><td><dfn id="rt-void-use">rt-void-use</dfn></td><td><code>RT_VOID_USE</code> (provisional)</td><td>Everywhere</td><td>A void result is used where a value is required. <emu-xref href="#sec-void-type"></emu-xref></td></tr>
      <tr><td><dfn id="rt-ambiguous-conversion">rt-ambiguous-conversion</dfn></td><td><code>RT_AMBIGUOUS_CONVERSION</code> (provisional)</td><td>Everywhere</td><td>More than one applicable conversion is maximal; provide a uniquely applicable conversion. <emu-xref href="#sec-conversions"></emu-xref></td></tr>
      <tr><td><dfn id="rt-undeclared-member">rt-undeclared-member</dfn></td><td><code>RT_UNDECLARED_MEMBER</code> (provisional)</td><td>Everywhere</td><td>The required member is not declared for the established receiver alternatives. <emu-xref href="#sec-typed-storage"></emu-xref></td></tr>
      <tr><td><dfn id="rt-immutable-pattern-binding">rt-immutable-pattern-binding</dfn></td><td><code>RT_IMMUTABLE_PATTERN_BINDING</code> (provisional)</td><td>Everywhere</td><td>The pattern binding is immutable. <emu-xref href="#sec-pattern-static-semantics"></emu-xref></td></tr>
      <tr><td><dfn id="rt-readonly-store">rt-readonly-store</dfn></td><td><code>RT_READONLY_STORE</code> (provisional)</td><td>Everywhere</td><td>The operation writes a declared readonly member. <emu-xref href="#sec-typed-storage"></emu-xref></td></tr>
      <tr><td><dfn id="rt-readonly-layout">rt-readonly-layout</dfn></td><td><code>RT_READONLY_LAYOUT</code> (provisional)</td><td>Everywhere</td><td>The operation writes an immutable type-layout property. <emu-xref href="#sec-layout-properties"></emu-xref></td></tr>
      <tr><td><dfn id="rt-missing-setter">rt-missing-setter</dfn></td><td><code>RT_MISSING_SETTER</code> (provisional)</td><td>Checked code</td><td>The established existing built-in accessor has no setter for the reached store. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-index-store">rt-index-store</dfn></td><td><code>RT_INDEX_STORE</code> (provisional)</td><td>Everywhere</td><td>The index operation supplies neither a setter nor a reference location. <emu-xref href="#sec-user-defined-operators"></emu-xref></td></tr>
      <tr><td><dfn id="rt-string-store">rt-string-store</dfn></td><td><code>RT_STRING_STORE</code> (provisional)</td><td>Everywhere</td><td>The operation writes a fixed string position. <emu-xref href="#sec-typed-string-properties"></emu-xref></td></tr>
      <tr><td><dfn id="rt-vector-lane-store">rt-vector-lane-store</dfn></td><td><code>RT_VECTOR_LANE_STORE</code> (provisional)</td><td>Everywhere</td><td>A vector store names a component more than once. <emu-xref href="#sec-vector-component-accessors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-duplicate-member">rt-duplicate-member</dfn></td><td><code>RT_DUPLICATE_MEMBER</code> (provisional)</td><td>Everywhere</td><td>A repeated member conflicts with the declared storage contract. <emu-xref href="#sec-typed-classes"></emu-xref></td></tr>
      <tr><td><dfn id="rt-index-signature">rt-index-signature</dfn></td><td><code>RT_INDEX_SIGNATURE</code> (provisional)</td><td>Everywhere</td><td>An index signature, indexed type, or index operand does not meet its declared key contract. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-partial-class">rt-partial-class</dfn></td><td><code>RT_PARTIAL_CLASS</code> (provisional)</td><td>Everywhere</td><td>The partial class contribution violates its target or contribution restrictions. <emu-xref href="#sec-partial-classes"></emu-xref></td></tr>
      <tr><td><dfn id="rt-meta-declaration">rt-meta-declaration</dfn></td><td><code>RT_META_DECLARATION</code> (provisional)</td><td>Everywhere</td><td>The meta declaration duplicates an owner or omits a required hook. <emu-xref href="#sec-meta-declarations"></emu-xref></td></tr>
      <tr><td><dfn id="rt-computed-member-name">rt-computed-member-name</dfn></td><td><code>RT_COMPUTED_MEMBER_NAME</code> (provisional)</td><td>Everywhere</td><td>The computed name is not an admitted constant member key. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-narrowing-declaration">rt-narrowing-declaration</dfn></td><td><code>RT_NARROWING_DECLARATION</code> (provisional)</td><td>Everywhere</td><td>The declared narrowing target does not name a parameter of this callable. <emu-xref href="#sec-declared-narrowing"></emu-xref></td></tr>
      <tr><td><dfn id="rt-layout">rt-layout</dfn></td><td><code>RT_LAYOUT</code> (provisional)</td><td>Everywhere</td><td>The declared storage cannot have the required finite layout. <emu-xref href="#sec-memory-layout"></emu-xref>, <emu-xref href="#sec-recursive-declaration-validation"></emu-xref></td></tr>
      <tr><td><dfn id="rt-overload-declaration">rt-overload-declaration</dfn></td><td><code>RT_OVERLOAD_DECLARATION</code> (provisional)</td><td>Everywhere</td><td>The declared overloads overlap in a prohibited or ambiguous way. <emu-xref href="#sec-callable-overload-contracts"></emu-xref></td></tr>
      <tr><td><dfn id="rt-implements-contract">rt-implements-contract</dfn></td><td><code>RT_IMPLEMENTS_CONTRACT</code> (provisional)</td><td>Everywhere</td><td>The implements target or implementing callable shape is invalid. <emu-xref href="#sec-typed-classes"></emu-xref></td></tr>
      <tr><td><dfn id="rt-generic-argument">rt-generic-argument</dfn></td><td><code>RT_GENERIC_ARGUMENT</code> (provisional)</td><td>Everywhere</td><td>The application does not supply the required kind, count, or inferable generic arguments. <emu-xref href="#sec-type-parameters"></emu-xref></td></tr>
      <tr><td><dfn id="rt-protected-member">rt-protected-member</dfn></td><td><code>RT_PROTECTED_MEMBER</code> (provisional)</td><td>Everywhere</td><td>The member is protected at this access. <emu-xref href="#sec-typed-classes"></emu-xref></td></tr>
      <tr><td><dfn id="rt-promise-protocol">rt-promise-protocol</dfn></td><td><code>RT_PROMISE_PROTOCOL</code> (provisional)</td><td>Everywhere</td><td>The established then contract cannot accept the assimilation callbacks. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-iterable-required">rt-iterable-required</dfn></td><td><code>RT_ITERABLE_REQUIRED</code> (provisional)</td><td>Everywhere</td><td>The required iterable operation is impossible for the established source. <emu-xref href="#sec-static-iteration-contribution"></emu-xref></td></tr>
      <tr><td><dfn id="rt-compile-time-evaluability">rt-compile-time-evaluability</dfn></td><td><code>RT_COMPILE_TIME_EVALUABILITY</code> (provisional)</td><td>Everywhere</td><td>The required type computation is outside the compile-time-evaluable fragment. <emu-xref href="#sec-compile-time-evaluability"></emu-xref></td></tr>
      <tr><td><dfn id="rt-parameter-order">rt-parameter-order</dfn></td><td><code>RT_PARAMETER_ORDER</code> (provisional)</td><td>Everywhere</td><td>The required positional parameter cannot follow this default without an unambiguous binding. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-member-default">rt-member-default</dfn></td><td><code>RT_MEMBER_DEFAULT</code> (provisional)</td><td>Everywhere</td><td>A member with a default must be optional. <emu-xref href="#sec-default-values"></emu-xref></td></tr>
      <tr><td><dfn id="rt-type-required">rt-type-required</dfn></td><td><code>RT_TYPE_REQUIRED</code> (provisional)</td><td>Everywhere</td><td>The type position or annotation does not denote the required type category. <emu-xref href="#sec-types-and-type-objects"></emu-xref></td></tr>
      <tr><td><dfn id="rt-integer-width">rt-integer-width</dfn></td><td><code>RT_INTEGER_WIDTH</code> (provisional)</td><td>Everywhere</td><td>The integer width is outside the specified integer-width domain. <emu-xref href="#sec-numeric-types-of-this-proposal"></emu-xref></td></tr>
      <tr><td><dfn id="rt-array-extent">rt-array-extent</dfn></td><td><code>RT_ARRAY_EXTENT</code> (provisional)</td><td>Everywhere</td><td>The array extent or type argument list is invalid. <emu-xref href="#sec-array-and-tuple-types"></emu-xref></td></tr>
      <tr><td><dfn id="rt-composite-type">rt-composite-type</dfn></td><td><code>RT_COMPOSITE_TYPE</code> (provisional)</td><td>Everywhere</td><td>The requested composite has an inadmissible component type or key. <emu-xref href="#sec-composite-typeobject-call"></emu-xref></td></tr>
      <tr><td><dfn id="rt-weak-target">rt-weak-target</dfn></td><td><code>RT_WEAK_TARGET</code> (provisional)</td><td>Everywhere</td><td>The declared weak collection cannot hold this value category. <emu-xref href="#sec-weak-references-and-typed-objects"></emu-xref></td></tr>
      <tr><td><dfn id="rt-explicit-conversion">rt-explicit-conversion</dfn></td><td><code>RT_EXPLICIT_CONVERSION</code> (provisional)</td><td>Everywhere</td><td>The explicit conversion is not defined for these types. <emu-xref href="#sec-conversions"></emu-xref></td></tr>
      <tr><td><dfn id="rt-constructor-required">rt-constructor-required</dfn></td><td><code>RT_CONSTRUCTOR_REQUIRED</code> (provisional)</td><td>Checked code</td><td>The established target cannot be constructed. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-range-value">rt-range-value</dfn></td><td><code>RT_RANGE_VALUE</code> (provisional)</td><td>Everywhere</td><td>The range has an inadmissible endpoint or produces a value outside its declared domain. <emu-xref href="#sec-ranges"></emu-xref></td></tr>
      <tr><td><dfn id="rt-numeric-range">rt-numeric-range</dfn></td><td><code>RT_NUMERIC_RANGE</code> (provisional)</td><td>Everywhere</td><td>The established value is outside the required numeric or literal domain. <emu-xref href="#sec-numericconvert"></emu-xref></td></tr>
      <tr><td><dfn id="rt-numeric-operator">rt-numeric-operator</dfn></td><td><code>RT_NUMERIC_OPERATOR</code> (provisional)</td><td>Everywhere</td><td>The numeric categories do not admit this operator together. <emu-xref href="#sec-operators"></emu-xref></td></tr>
      <tr><td><dfn id="rt-disjoint-comparison">rt-disjoint-comparison</dfn></td><td><code>RT_DISJOINT_COMPARISON</code> (provisional)</td><td>Checked code</td><td>The established operands share no value for this comparison. <emu-xref href="#sec-narrowfrom"></emu-xref></td></tr>
      <tr><td><dfn id="rt-zero-divisor">rt-zero-divisor</dfn></td><td><code>RT_ZERO_DIVISOR</code> (provisional)</td><td>Everywhere</td><td>The literal divisor is zero where the typed operation forbids it. <emu-xref href="#sec-operators"></emu-xref></td></tr>
      <tr><td><dfn id="rt-shift-distance">rt-shift-distance</dfn></td><td><code>RT_SHIFT_DISTANCE</code> (provisional)</td><td>Everywhere</td><td>The typed shift distance is negative or removes every bit. <emu-xref href="#sec-operators"></emu-xref></td></tr>
      <tr><td><dfn id="rt-required-member">rt-required-member</dfn></td><td><code>RT_REQUIRED_MEMBER</code> (provisional)</td><td>Everywhere</td><td>The value omits a required declared member. <emu-xref href="#sec-typed-storage"></emu-xref></td></tr>
      <tr><td><dfn id="rt-constant-condition">rt-constant-condition</dfn></td><td><code>RT_CONSTANT_CONDITION</code> (provisional)</td><td>Checked code</td><td>The deciding value has only truthy or only falsy alternatives. <emu-xref href="#sec-falsy-and-truthy-parts"></emu-xref></td></tr>
      <tr><td><dfn id="rt-impossible-assertion">rt-impossible-assertion</dfn></td><td><code>RT_IMPOSSIBLE_ASSERTION</code> (provisional)</td><td>Checked code</td><td>The asserted stable domain cannot admit the established value. <emu-xref href="#sec-declared-narrowing"></emu-xref></td></tr>
      <tr><td><dfn id="rt-unreachable-operand">rt-unreachable-operand</dfn></td><td><code>RT_UNREACHABLE_OPERAND</code> (provisional)</td><td>Checked code</td><td>The deciding left operand necessarily skips the right operand. <emu-xref href="#sec-narrowing-flow"></emu-xref></td></tr>
      <tr><td><dfn id="rt-pattern-domain">rt-pattern-domain</dfn></td><td><code>RT_PATTERN_DOMAIN</code> (provisional)</td><td>Everywhere</td><td>The pattern cannot match or unambiguously describe the required position. <emu-xref href="#sec-pattern-static-semantics"></emu-xref></td></tr>
      <tr><td><dfn id="rt-matcher-contract">rt-matcher-contract</dfn></td><td><code>RT_MATCHER_CONTRACT</code> (provisional)</td><td>Everywhere</td><td>The custom matcher is absent or has an incompatible callable/result contract. <emu-xref href="#sec-pattern-static-semantics"></emu-xref></td></tr>
      <tr><td><dfn id="rt-unreachable-pattern">rt-unreachable-pattern</dfn></td><td><code>RT_UNREACHABLE_PATTERN</code> (provisional)</td><td>Checked code</td><td>No remaining value can reach this pattern clause. <emu-xref href="#sec-pattern-static-semantics"></emu-xref></td></tr>
      <tr><td><dfn id="rt-nonexhaustive-match">rt-nonexhaustive-match</dfn></td><td><code>RT_NONEXHAUSTIVE_MATCH</code> (provisional)</td><td>Everywhere</td><td>The match omits a required case or catch-all. <emu-xref href="#sec-pattern-static-semantics"></emu-xref></td></tr>
      <tr><td><dfn id="rt-unreachable-default">rt-unreachable-default</dfn></td><td><code>RT_UNREACHABLE_DEFAULT</code> (provisional)</td><td>Checked code</td><td>Earlier cases cover every admitted value, so the default cannot be selected. <emu-xref href="#sec-narrowing-flow"></emu-xref></td></tr>
      <tr><td><dfn id="rt-pattern-scope">rt-pattern-scope</dfn></td><td><code>RT_PATTERN_SCOPE</code> (provisional)</td><td>Everywhere</td><td>The binding-carrying pattern is outside its governing position or scope. <emu-xref href="#sec-pattern-static-semantics"></emu-xref></td></tr>
      <tr><td><dfn id="rt-return-inference">rt-return-inference</dfn></td><td><code>RT_RETURN_INFERENCE</code> (provisional)</td><td>Everywhere</td><td>Return inference grows without a finite result; write an explicit return type. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-unproductive-type">rt-unproductive-type</dfn></td><td><code>RT_UNPRODUCTIVE_TYPE</code> (provisional)</td><td>Everywhere</td><td>The alias only defines itself and produces no type. <emu-xref href="#sec-type-alias-declarations"></emu-xref>, <emu-xref href="#sec-recursive-declaration-validation"></emu-xref></td></tr>
      <tr><td><dfn id="rt-reference-location">rt-reference-location</dfn></td><td><code>RT_REFERENCE_LOCATION</code> (provisional)</td><td>Everywhere</td><td>The operation requires a referenceable location, not merely a value. <emu-xref href="#sec-reference-values"></emu-xref></td></tr>
      <tr><td><dfn id="rt-fixed-extent-store">rt-fixed-extent-store</dfn></td><td><code>RT_FIXED_EXTENT_STORE</code> (provisional)</td><td>Everywhere</td><td>The operation changes a fixed sequence extent. <emu-xref href="#sec-typed-storage"></emu-xref></td></tr>
      <tr><td><dfn id="rt-property-receiver">rt-property-receiver</dfn></td><td><code>RT_PROPERTY_RECEIVER</code> (provisional)</td><td>Checked code</td><td>The established receiver cannot support the required property operation. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-conversion-protocol">rt-conversion-protocol</dfn></td><td><code>RT_CONVERSION_PROTOCOL</code> (provisional)</td><td>Everywhere</td><td>The selected typed conversion protocol cannot satisfy the reached operation. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-iterator-close">rt-iterator-close</dfn></td><td><code>RT_ITERATOR_CLOSE</code> (provisional)</td><td>Everywhere</td><td>The reached iterator close cannot satisfy its declared protocol contract. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-named-argument">rt-named-argument</dfn></td><td><code>RT_NAMED_ARGUMENT</code> (provisional)</td><td>Everywhere</td><td>Named and positional arguments cannot bind the signature as written. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-builtin-argument">rt-builtin-argument</dfn></td><td><code>RT_BUILTIN_ARGUMENT</code> (provisional)</td><td>Checked code</td><td>The established arguments cannot satisfy the added contract of the existing built-in operation. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-atomic-argument">rt-atomic-argument</dfn></td><td><code>RT_ATOMIC_ARGUMENT</code> (provisional)</td><td>Everywhere</td><td>The typed atomic operation requires a supported location and operand category. <emu-xref href="#sec-atomics-typed-operations"></emu-xref></td></tr>
      <tr><td><dfn id="rt-typed-array-store">rt-typed-array-store</dfn></td><td><code>RT_TYPED_ARRAY_STORE</code> (provisional)</td><td>Everywhere</td><td>The established intrinsic array store cannot convert to the declared element type. <emu-xref href="#sec-array-defaults-and-stores"></emu-xref></td></tr>
      <tr><td><dfn id="rt-call-argument">rt-call-argument</dfn></td><td><code>RT_CALL_ARGUMENT</code> (provisional)</td><td>Everywhere</td><td>No argument binding can satisfy the required callable contract. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-ambiguous-call">rt-ambiguous-call</dfn></td><td><code>RT_AMBIGUOUS_CALL</code> (provisional)</td><td>Everywhere</td><td>Multiple declared signatures remain applicable without a unique selection. <emu-xref href="#sec-overload-resolution"></emu-xref></td></tr>
      <tr><td><dfn id="rt-not-callable">rt-not-callable</dfn></td><td><code>RT_NOT_CALLABLE</code> (provisional)</td><td>Checked code</td><td>The established callee is not callable. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-decorator-argument">rt-decorator-argument</dfn></td><td><code>RT_DECORATOR_ARGUMENT</code> (provisional)</td><td>Everywhere</td><td>The decorator cannot accept its written arguments and object context. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-reference-argument">rt-reference-argument</dfn></td><td><code>RT_REFERENCE_ARGUMENT</code> (provisional)</td><td>Everywhere</td><td>The argument does not supply the required reference or reference type. <emu-xref href="#sec-reference-parameters-and-arguments"></emu-xref></td></tr>
      <tr><td><dfn id="rt-proxy-storage">rt-proxy-storage</dfn></td><td><code>RT_PROXY_STORAGE</code> (provisional)</td><td>Everywhere</td><td>A Proxy cannot wrap the specified protected typed storage. <emu-xref href="#sec-typed-storage"></emu-xref></td></tr>
      <tr><td><dfn id="rt-collection-seed">rt-collection-seed</dfn></td><td><code>RT_COLLECTION_SEED</code> (provisional)</td><td>Everywhere</td><td>A surviving seed entry cannot satisfy its declared collection element contract. <emu-xref href="#sec-collection-iteration"></emu-xref></td></tr>
      <tr><td><dfn id="rt-this-required">rt-this-required</dfn></td><td><code>RT_THIS_REQUIRED</code> (provisional)</td><td>Everywhere</td><td>The call lacks the receiver required by the declared method contract. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-duplicate-operator">rt-duplicate-operator</dfn></td><td><code>RT_DUPLICATE_OPERATOR</code> (provisional)</td><td>Everywhere</td><td>The operator overlaps an already declared primitive operation. <emu-xref href="#sec-primitive-operator-blocks"></emu-xref></td></tr>
      <tr><td><dfn id="rt-empty-iteration">rt-empty-iteration</dfn></td><td><code>RT_EMPTY_ITERATION</code> (provisional)</td><td>Checked code</td><td>The established source has no element, so the loop body cannot execute. <emu-xref href="#sec-narrowing-flow"></emu-xref></td></tr>
      <tr><td><dfn id="rt-reference-iteration">rt-reference-iteration</dfn></td><td><code>RT_REFERENCE_ITERATION</code> (provisional)</td><td>Everywhere</td><td>The iteration cannot supply references to its elements. <emu-xref href="#sec-reference-iteration"></emu-xref></td></tr>
      <tr><td><dfn id="rt-disposal-contract">rt-disposal-contract</dfn></td><td><code>RT_DISPOSAL_CONTRACT</code> (provisional)</td><td>Everywhere</td><td>The selected disposal hook cannot satisfy the required call contract. <emu-xref href="#sec-typed-resource-management"></emu-xref></td></tr>
      <tr><td><dfn id="rt-instanceof-protocol">rt-instanceof-protocol</dfn></td><td><code>RT_INSTANCEOF_PROTOCOL</code> (provisional)</td><td>Checked code</td><td>An added instanceof protocol requirement cannot be satisfied in checked code. <emu-xref href="#sec-operator-results"></emu-xref>, <emu-xref href="#sec-type-rule-applicability"></emu-xref></td></tr>
      <tr><td><dfn id="rt-instanceof-declared-call">rt-instanceof-declared-call</dfn></td><td><code>RT_INSTANCEOF_PROTOCOL</code> (provisional)</td><td>Everywhere</td><td>Every selected callable instanceof hook violates its declared receiver or parameter contract. <emu-xref href="#sec-operator-results"></emu-xref>, <emu-xref href="#sec-type-rule-applicability"></emu-xref></td></tr>
      <tr><td><dfn id="rt-object-operand">rt-object-operand</dfn></td><td><code>RT_OBJECT_OPERAND</code> (provisional)</td><td>Checked code</td><td>The operator requires an Object right operand. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-catch-order">rt-catch-order</dfn></td><td><code>RT_CATCH_ORDER</code> (provisional)</td><td>Everywhere</td><td>An untyped catch must be the final handler. <emu-xref href="#sec-typed-catch"></emu-xref></td></tr>
      <tr><td><dfn id="rt-unreachable-catch">rt-unreachable-catch</dfn></td><td><code>RT_UNREACHABLE_CATCH</code> (provisional)</td><td>Checked code</td><td>Previous catch filters admit every value this handler could accept. <emu-xref href="#sec-typed-catch"></emu-xref></td></tr>
      <tr><td><dfn id="rt-enum-case">rt-enum-case</dfn></td><td><code>RT_ENUM_CASE</code> (provisional)</td><td>Everywhere</td><td>The enum switch names an invalid case or omits a required case. <emu-xref href="#sec-enums"></emu-xref></td></tr>
      <tr><td><dfn id="rt-unreachable-range-case">rt-unreachable-range-case</dfn></td><td><code>RT_UNREACHABLE_RANGE_CASE</code> (provisional)</td><td>Checked code</td><td>Earlier range labels cover every value this label could select. <emu-xref href="#sec-narrowing-flow"></emu-xref></td></tr>
      <tr><td><dfn id="rt-declaration-inference">rt-declaration-inference</dfn></td><td><code>RT_DECLARATION_INFERENCE</code> (provisional)</td><td>Everywhere</td><td>The declaration requires a static type that its initializer does not establish. <emu-xref href="#sec-typed-bindings"></emu-xref></td></tr>
      <tr><td><dfn id="rt-reference-rebinding">rt-reference-rebinding</dfn></td><td><code>RT_REFERENCE_REBINDING</code> (provisional)</td><td>Everywhere</td><td>The destination is not a rebindable reference binding. <emu-xref href="#sec-reference-bindings"></emu-xref></td></tr>
      <tr><td><dfn id="rt-typed-delete">rt-typed-delete</dfn></td><td><code>RT_TYPED_DELETE</code> (provisional)</td><td>Everywhere</td><td>The operation deletes protected typed storage. <emu-xref href="#sec-typed-storage"></emu-xref></td></tr>
      <tr><td><dfn id="rt-abstract-construction">rt-abstract-construction</dfn></td><td><code>RT_ABSTRACT_CONSTRUCTION</code> (provisional)</td><td>Everywhere</td><td>An abstract class cannot be constructed. <emu-xref href="#sec-typed-classes"></emu-xref></td></tr>
      <tr><td><dfn id="rt-declared-zero">rt-declared-zero</dfn></td><td><code>RT_DECLARED_ZERO</code> (provisional)</td><td>Everywhere</td><td>The declared zero does not satisfy the type. <emu-xref href="#sec-declared-zero"></emu-xref></td></tr>
      <tr><td><dfn id="rt-superclass-contract">rt-superclass-contract</dfn></td><td><code>RT_SUPERCLASS_CONTRACT</code> (provisional)</td><td>Everywhere</td><td>The typed superclass does not satisfy the constructor/prototype contract. <emu-xref href="#sec-typed-classes"></emu-xref></td></tr>
      <tr><td><dfn id="rt-ambiguous-result">rt-ambiguous-result</dfn></td><td><code>RT_AMBIGUOUS_RESULT</code> (provisional)</td><td>Everywhere</td><td>Several comparison result forms remain possible; supply a result context. <emu-xref href="#sec-overloading-on-return-type"></emu-xref></td></tr>
      <tr><td><dfn id="rt-operator-argument">rt-operator-argument</dfn></td><td><code>RT_OPERATOR_ARGUMENT</code> (provisional)</td><td>Everywhere</td><td>No declared operator signature accepts these operands. <emu-xref href="#sec-overload-resolution"></emu-xref></td></tr>
      <tr><td><dfn id="rt-ambiguous-operator">rt-ambiguous-operator</dfn></td><td><code>RT_AMBIGUOUS_OPERATOR</code> (provisional)</td><td>Everywhere</td><td>More than one declared operator signature remains applicable. <emu-xref href="#sec-overload-resolution"></emu-xref></td></tr>
      <tr><td><dfn id="rt-parameter-kind">rt-parameter-kind</dfn></td><td><code>RT_PARAMETER_KIND</code> (provisional)</td><td>Everywhere</td><td>The written parameter domain does not determine an admitted parameter kind. <emu-xref href="#sec-parameter-kinds"></emu-xref></td></tr>
      <tr><td><dfn id="rt-specialization-contract">rt-specialization-contract</dfn></td><td><code>RT_SPECIALIZATION_CONTRACT</code> (provisional)</td><td>Everywhere</td><td>The specialized declaration does not preserve its owner contract or has invalid selection patterns. <emu-xref href="#sec-callable-overload-contracts"></emu-xref></td></tr>
      <tr><td><dfn id="rt-type-default-identity">rt-type-default-identity</dfn></td><td><code>RT_TYPE_DEFAULT_IDENTITY</code> (provisional)</td><td>Everywhere</td><td>A shared type default must have value semantics. <emu-xref href="#sec-default-values"></emu-xref></td></tr>
      <tr><td><dfn id="rt-reference-permission">rt-reference-permission</dfn></td><td><code>RT_REFERENCE_PERMISSION</code> (provisional)</td><td>Everywhere</td><td>The reference operation violates its access or lifetime permission. <emu-xref href="#sec-reference-alias-write-permission"></emu-xref></td></tr>
      <tr><td><dfn id="rt-vector-argument">rt-vector-argument</dfn></td><td><code>RT_VECTOR_ARGUMENT</code> (provisional)</td><td>Everywhere</td><td>The vector application does not meet its element, extent, or lane contract. <emu-xref href="#sec-vector-types"></emu-xref></td></tr>
      <tr><td><dfn id="rt-type-evaluation-limit">rt-type-evaluation-limit</dfn></td><td><code>RT_TYPE_EVALUATION_LIMIT</code> (provisional)</td><td>Everywhere</td><td>The specified semantic work limit is exhausted; the computation supplies no fallback type. <emu-xref href="#sec-evaluation-budget"></emu-xref>, <emu-xref href="#sec-type-evaluation-accounting"></emu-xref></td></tr>
      <tr><td><dfn id="rt-proposal-construction">rt-proposal-construction</dfn></td><td><code>RT_CONSTRUCTOR_REQUIRED</code> (provisional)</td><td>Everywhere</td><td>The established target cannot be constructed. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
      <tr><td><dfn id="rt-declared-call">rt-declared-call</dfn></td><td><code>RT_NOT_CALLABLE</code> (provisional)</td><td>Everywhere</td><td>The established callee is not callable. <emu-xref href="#sec-type-errors"></emu-xref></td></tr>
    </tbody>
  </table></emu-table>
</emu-clause>
